# Copie para .env e preencha. Nunca commite o .env nem valores reais.

# --- Aplicação ---
APP_NAME=ClinIA

# --- WhatsApp / Integrações ---
# simulator (padrão, nenhuma credencial exigida) ou cloud (todas as abaixo são obrigatórias)
WHATSAPP_MODE=simulator
# Token Bearer da Cloud API (painel Meta > WhatsApp > Configuração da API)
WHATSAPP_ACCESS_TOKEN=
# ID do número de envio (não é o número de telefone)
WHATSAPP_PHONE_NUMBER_ID=
# Chave secreta do app Meta, usada no HMAC do header X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Valor aleatório nosso, cadastrado no painel da Meta para o handshake do webhook
WHATSAPP_VERIFY_TOKEN=
# Versão da Graph API, ex.: v23.0
WHATSAPP_GRAPH_VERSION=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_HTTP_TIMEOUT_SECONDS=10
WHATSAPP_SEND_MAX_ATTEMPTS=3
# Vazio = simulador ligado apenas em WHATSAPP_MODE=simulator. true/false força.
SIMULATOR_ENABLED=
