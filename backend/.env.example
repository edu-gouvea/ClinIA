# Copie para .env e preencha. Nunca commite o .env nem valores reais.

# --- Aplicação ---
# APP_ENV=development         # development | staging | production | test
# APP_NAME=ClinIA

# --- Banco de dados ---
# DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5432/clinia
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5433/clinia_test

# --- JWT ---
# JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7

# --- CORS (lista separada por vírgula) ---
# CORS_ORIGINS=http://localhost:3000,https://app.clinia.com.br

# --- Logs ---
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# --- CRM externo ---
# CAMINHO_DO_CRM=             # caminho/URL do CRM (preenchido pelo responsável)

# --- Feature flags ---
# SIMULATOR_ENABLED=true
# AGENT_PROVIDER=fake         # fake | openai | anthropic
